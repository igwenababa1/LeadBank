# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# RESEND_API_KEY: Required for sending real-time transactional banking emails.
# Users configure this via the Secrets panel in AI Studio.
RESEND_API_KEY="MY_RESEND_API_KEY_DEFAULT_VALUE"

# TWILIO_ACCOUNT_SID: Twilio Account SID for sending high-priority SMS notifications and approval codes.
TWILIO_ACCOUNT_SID="MY_TWILIO_ACCOUNT_SID_DEFAULT_VALUE"

# TWILIO_AUTH_TOKEN: Twilio Auth Token for SMS API authentication.
TWILIO_AUTH_TOKEN="MY_TWILIO_AUTH_TOKEN_DEFAULT_VALUE"

# TWILIO_FROM_NUMBER: Twilio Sender Phone Number (E.164 format, e.g. +18005550199).
TWILIO_FROM_NUMBER="+18005550199"

